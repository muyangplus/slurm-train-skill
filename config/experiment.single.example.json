{
  "schema_version": 1,
  "name": "baseline-2gpu",
  "mode": "single",
  "inputs": {
    "data": "datasets/custom.yaml",
    "model": "weights/model.pt"
  },
  "output_dir": "runs/baseline-2gpu",
  "resources": {
    "cpus_per_task": 8,
    "gpus_per_task": 2,
    "time_limit": "24:00:00",
    "memory": "128G"
  },
  "train_command": [
    "yolo", "train", "data={data}", "model={model}", "epochs=100",
    "batch=64", "imgsz=640", "workers=8", "project={output_parent}",
    "name={name}", "exist_ok=True"
  ],
  "validation_command": [
    "yolo", "val", "model={best_model}", "data={data}",
    "project={output_parent}", "name={name}-val", "exist_ok=True"
  ],
  "artifacts": ["results.csv", "results.png", "weights/best.pt", "weights/last.pt"]
}
